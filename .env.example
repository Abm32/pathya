# Meta Model API (https://dev.meta.ai/platform)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# PharmCAT runner: "docker" (pgkb/pharmcat image, dev), "local" (inside the Dockerfile image), or "jar" (PHARMCAT_JAR + java 17+)
PHARMCAT_RUNNER=docker
PHARMCAT_HOME=/pharmcat
PHARMCAT_JAR=
# Uploads + PharmCAT outputs (gitignored)
DATA_DIR=./data
# Shared access code for the demo deployment (empty = no auth)
ACCESS_CODE=
# Case ids readable without the code (read-only demo); the first one is what /sample opens
PUBLIC_CASES=
# Muse Spark Open (open weights) via Baseten — second inference path + self-host story.
# Hackathon key only works with meta-models/muse-spark-open-1026.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Primary provider for text generation: meta | baseten (other one is automatic fallback)
MUSE_PROVIDER=meta
